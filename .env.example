# ==========================================
# Meeting Intelligence System - Environment Config
# ==========================================

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

# Database & Storage
DATABASE_URL=sqlite:///./data/mis.db
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
VECTOR_DIR=./data/vectors

# Local AI Models - Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_FALLBACK_MODELS=qwen2.5:7b,llama3.2:3b,mistral:7b

# Speech-to-Text & Diarization - Deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-2

# Speech-to-Text - NVIDIA Parakeet (Legacy/Local)
PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v2
PARAKEET_FALLBACK_MODEL=nvidia/parakeet-tdt-0.6b-v2
PARAKEET_DEVICE=auto  # auto, cuda, cpu
PARAKEET_COMPUTE_TYPE=float16  # float16, int8, float32

# Speaker Diarization - pyannote.audio
# Free HuggingFace token with pyannote/speaker-diarization-3.1 license accepted
# Leave blank to run in single-speaker graceful fallback mode
HF_TOKEN = 

# Embedding Model - sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Worker / Processing
MAX_WORKERS=2
CHUNK_TOKEN_SIZE=1200
CHUNK_OVERLAP_TOKENS=150
